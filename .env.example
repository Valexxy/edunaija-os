# ================================================================
# EduNaija OS — Complete Environment Variables
# Nigeria's AI-powered Education Operating System
# ================================================================

# ============================================
# TELEGRAM
# ============================================
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=generate_a_random_32char_string
TELEGRAM_BOT_USERNAME=edunaija_bot

# ============================================
# SUPABASE
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# GOOGLE GEMINI AI
# ============================================
GEMINI_API_KEY=your_gemini_api_key_from_aistudio
GEMINI_MODEL_FLASH=gemini-1.5-flash
GEMINI_MODEL_PRO=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ============================================
# PAYSTACK (Nigerian Payments)
# ============================================
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ============================================
# AFRICA'S TALKING (SMS + USSD)
# ============================================
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key
AFRICAS_TALKING_SENDER_ID=EduNaija
AFRICAS_TALKING_USSD_CODE=*347*99#

# ============================================
# WHATSAPP (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ============================================
# REDIS (Upstash - Free Tier)
# ============================================
REDIS_URL=redis://default:your_password@your_endpoint.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ============================================
# N8N WORKFLOWS
# ============================================
N8N_BASE_URL=https://your-n8n-instance.onrender.com
N8N_API_KEY=your_n8n_api_key
N8N_PARENT_REPORT_WEBHOOK=https://n8n.onrender.com/webhook/parent-report
N8N_HEART_REFILL_WEBHOOK=https://n8n.onrender.com/webhook/heart-refill
N8N_CLAN_WAR_WEBHOOK=https://n8n.onrender.com/webhook/clan-war

# ============================================
# OCR (Photo Scanner)
# ============================================
GOOGLE_CLOUD_VISION_API_KEY=your_cloud_vision_api_key

# ============================================
# APP CONFIG
# ============================================
ENVIRONMENT=development
APP_URL=https://your-app.onrender.com
PWA_URL=https://your-pwa.pages.dev
DAILY_HEART_LIMIT=20
HEARTS_PER_3_GROUP_SHARE=10
HEARTS_PER_SINGLE_REFERRAL=5
FSRS_DESIRED_RETENTION=0.90
BKT_MASTERY_THRESHOLD=0.95

# ============================================
# PRICING (in Kobo)
# ============================================
CRAM_PASS_PRICE_KOBO=20000
SEASON_PASS_PRICE_KOBO=500000
PARENT_DASHBOARD_PRICE_KOBO=300000
B2B_TUTORIAL_LICENSE_KOBO=5000000
B2B_SCHOOL_LICENSE_KOBO=20000000

# ============================================
# EXAM DATES 2025/2026
# ============================================
JAMB_EXAM_DATE_2025=2025-04-24
WAEC_EXAM_DATE_2025=2025-05-05
NECO_EXAM_DATE_2025=2025-06-10
COMMON_ENTRANCE_DATE_2025=2025-06-14

# ============================================
# SUPPORTED EXAMS (comma-separated)
# ============================================
SUPPORTED_EXAMS=JAMB,WAEC,NECO,POST_UTME,COMMON_ENTRANCE,BECE,ICAN,IELTS

# ============================================
# MULTILINGUAL (Nigerian Languages)
# ============================================
DEFAULT_LANGUAGE=english
SUPPORTED_LANGUAGES=english,pidgin,yoruba,hausa,igbo

# ============================================
# COMPETITION ENGINE
# ============================================
MAX_PLAYERS_PER_ROOM=50
QUESTIONS_PER_SPRINT=30
SECONDS_PER_QUESTION=30
SPEED_BONUS_FAST_MS=5000
SPEED_BONUS_MEDIUM_MS=10000
