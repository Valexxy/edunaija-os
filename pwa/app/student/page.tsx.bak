              <p className="text-zinc-300 text-xs mb-3">
                {isPrimary ? "Spelling Bee & Mental Maths • Top 10 win 500MB Data & Gold Trophy" : "Top 10 win 500MB Data + Verified Champion Badge"}
              </p>

              {/* Live Countdown Clock Widget */}
              <div className="grid grid-cols-4 gap-2 mb-4 text-center">
                {[
                  { label: "DAYS", value: showdownCountdown.days },
                  { label: "HOURS", value: String(showdownCountdown.hours).padStart(2, "0") },
                  { label: "MINS", value: String(showdownCountdown.mins).padStart(2, "0") },
                  { label: "SECS", value: String(showdownCountdown.secs).padStart(2, "0") }
                ].map(box => (
                  <div key={box.label} className="p-2 rounded-xl bg-black/50 border border-white/10">
                    <div className="text-lg font-mono font-black text-naija-gold leading-none">{box.value}</div>
                    <div className="text-[8px] font-bold text-zinc-400 tracking-widest mt-1">{box.label}</div>
                  </div>
                ))}
              </div>

              <div className="w-full bg-gradient-to-r from-naija-gold to-amber-500 text-black font-display font-black text-xs py-2.5 rounded-xl text-center shadow-[0_0_20px_rgba(255,215,0,0.35)] flex items-center justify-center gap-2 hover:brightness-110 transition-all">
                {isPrimary ? "Enter Wonder Arena" : "Enter Live Arena"} <ArrowRight className="w-3.5 h-3.5 stroke-[2.5]" />
              </div>
            </motion.div>
