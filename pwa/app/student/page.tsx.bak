            <div className="space-y-2 text-xs">
              <div className="flex justify-between items-center p-2.5 rounded-xl bg-white/5 border border-white/5">
                <div className="flex items-center gap-2">
                  <span className="w-2 h-2 rounded-full bg-purple-400" />
                  <span className="font-semibold text-white">{isPrimary ? "Wed 4:00 PM" : "Wed 6:00 PM"}</span>
                  <span className="text-zinc-400">• {isPrimary ? "Phonics Story Hour" : "Speed Drill"}</span>
                </div>
                <span className="text-[10px] font-bold text-purple-300">{isPrimary ? "+150 Stars" : "+250 XP"}</span>
              </div>

              <div className="flex justify-between items-center p-2.5 rounded-xl bg-white/5 border border-white/5">
                <div className="flex items-center gap-2">
                  <span className="w-2 h-2 rounded-full bg-amber-400" />
                  <span className="font-semibold text-white">{isPrimary ? "Fri 5:00 PM" : "Fri 7:00 PM"}</span>
                  <span className="text-zinc-400">• {isPrimary ? "Mental Maths Duel" : "Clan Wars"}</span>
                </div>
                <span className="text-[10px] font-bold text-amber-300">{isPrimary ? "1.5x Stars" : "1.25x"}</span>
              </div>

              <div className="flex justify-between items-center p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30">
                <div className="flex items-center gap-2">
                  <span className="w-2 h-2 rounded-full bg-[#00E676] animate-pulse" />
                  <span className="font-semibold text-white">{isPrimary ? "Sat 10:00 AM" : "Sun 8:00 PM"}</span>
                  <span className="text-zinc-300">• {isPrimary ? "Common Entrance Drill" : "National Mock"}</span>
                </div>
                <span className="text-[10px] font-bold text-[#00E676]">500MB Data</span>
              </div>
