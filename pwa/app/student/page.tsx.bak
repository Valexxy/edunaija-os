            >
              <div className="flex justify-between items-center mb-3">
                <span className="px-2.5 py-1 rounded-full text-[10px] font-black bg-red-500/20 text-red-400 border border-red-500/40 flex items-center gap-1.5 animate-pulse">
                  <span className="w-1.5 h-1.5 rounded-full bg-red-500" /> SUNDAY 8:00 PM WAT
                </span>
                <span className="text-xs font-bold text-naija-gold flex items-center gap-1 bg-amber-500/10 px-2.5 py-0.5 rounded-full border border-amber-500/20">
                  <Users className="w-3.5 h-3.5" /> 14,820 Live
                </span>
              </div>

              <h3 className="font-display font-black text-lg text-white tracking-tight mb-1">
