                        <ExternalLink className="w-2.5 h-2.5" />
                      </a>
                    </div>
                    <div className="text-xs font-semibold text-white leading-tight">{feed.headline}</div>
                    <p className="text-[11px] text-zinc-400 line-clamp-2">{feed.summary}</p>
                  </div>
                ))
              ) : (
                <div className="text-xs text-zinc-500 text-center py-2">
                  {isPrimary ? "Connected to NERDC & UBEC portals." : "Connected to JAMB, NERDC & UNILAG web portals."}
                </div>
              )}
            </div>
