          <section className="space-y-3">
            {/* Banner 1: Parent Guardian Angel Pass */}
            <div className="p-4 rounded-3xl bg-gradient-to-br from-emerald-950/50 via-zinc-900 to-black border border-emerald-500/30 space-y-2.5 shadow-xl">
              <div className="flex items-start justify-between">
                <div>
                  <span className="text-[10px] font-mono font-bold text-[#00E676] uppercase">👨‍👩‍👧 For Parents</span>
                  <h3 className="font-bold text-xs text-white">Guardian Angel Weekly Report</h3>
                </div>
                <span className="font-mono text-[11px] font-black text-[#00E676] bg-emerald-500/10 px-2 py-0.5 rounded-xl border border-emerald-500/30">
