"use client";

import { useState, useEffect } from "react";
import { motion } from "framer-motion";
import Link from "next/link";
import { 
  Zap, Flame, Trophy, BookOpen, ChevronRight, ShieldAlert, Sparkles, 
  Share2, Users, Bell, Clock, Calendar, ArrowRight, FileCheck2, Radio, CheckCircle2,
  ExternalLink, RefreshCw, Bot, MapPin, Compass, Terminal, GraduationCap, School, Lock, Unlock,
  KeyRound, Brain, AlertTriangle, Eye
} from "lucide-react";
import HeartBar from "../../components/HeartBar";
import UserProfileModal from "../../components/UserProfileModal";
import ClassPromotionModal from "../../components/ClassPromotionModal";
import SmartAmbientGreeting from "../../components/SmartAmbientGreeting";
import SmartResumeCard from "../../components/SmartResumeCard";
import VerifiableLearningHistoryModal from "../../components/VerifiableLearningHistoryModal";
import AddToCalendarModal from "../../components/AddToCalendarModal";
import InteractiveCampusMap from "../../components/InteractiveCampusMap";
import DevModeToggle from "../../components/DevModeToggle";
import CognitiveSynapseGraph from "../../components/CognitiveSynapseGraph";
import RoadToGradeAWidget from "../../components/RoadToGradeAWidget";
import { sfx } from "../../lib/audio";
import { initTelegramMiniApp, triggerTmaHaptic } from "../../lib/telegram";

export default function StudentDashboard() {
  const [showdownCountdown, setShowdownCountdown] = useState({ days: 1, hours: 5, mins: 24, secs: 30 });
  const [user, setUser] = useState<any>(null);
  const [isProfileModalOpen, setIsProfileModalOpen] = useState(false);
  const [isGuestPreview, setIsGuestPreview] = useState(false);

  // Academic Track (Arts vs Science vs Commercial vs 100L) & Institutional Clearinghouse
  const [academicTrack, setAcademicTrack] = useState<string>("SCIENCE");
  const [institutionalRadar, setInstitutionalRadar] = useState<any[]>([]);
  const [prescribedLit, setPrescribedLit] = useState<any[]>([]);
  const [isChangingTrack, setIsChangingTrack] = useState(false);

  // Dynamic Class Progression State (Primary to 100L)
  const [classTier, setClassTier] = useState<string>("UTME");

  // Anti-Cheat Class Promotion Modal State
  const [isPromotionModalOpen, setIsPromotionModalOpen] = useState(false);
  const [isHistoryModalOpen, setIsHistoryModalOpen] = useState(false);
  const [isCalendarModalOpen, setIsCalendarModalOpen] = useState(false);
  const [isMapModalOpen, setIsMapModalOpen] = useState(false);
  const [isDevMode, setIsDevMode] = useState(false);
  const [targetPromotionTier, setTargetPromotionTier] = useState<string>("SSS");

  // High-Yield Monetization Modals
  const [isParentModalOpen, setIsParentModalOpen] = useState(false);
  const [isSchoolModalOpen, setIsSchoolModalOpen] = useState(false);
  const [parentName, setParentName] = useState("");
  const [parentPhone, setParentPhone] = useState("");
  const [parentPlan, setParentPlan] = useState("guardian_monthly");
  const [parentSuccessMsg, setParentSuccessMsg] = useState<string | null>(null);

  const [schoolName, setSchoolName] = useState("");
  const [schoolEmail, setSchoolEmail] = useState("");
  const [schoolPhone, setSchoolPhone] = useState("");
  const [schoolSeats, setSchoolSeats] = useState(250);
  const [schoolSuccessMsg, setSchoolSuccessMsg] = useState<string | null>(null);

  // Live External Feeds State
  const [portalFeeds, setPortalFeeds] = useState<any[]>([]);
  const [isSyncingFeeds, setIsSyncingFeeds] = useState(false);
  const [liveStats, setLiveStats] = useState<any>(null);

  // Sync user state from localStorage and cross-component custom events
  useEffect(() => {
    if (typeof window !== "undefined") {
      const stored = localStorage.getItem("edunaija_user");
      let activeTier = "UTME";
      if (stored) {
        try {
          const parsed = JSON.parse(stored);
          setUser(parsed);
          const raw = parsed.class_tier || parsed.grade_level;
          if (raw) activeTier = String(raw).toUpperCase();
        } catch {}
      } else {
        const savedTier = localStorage.getItem("edunaija_class_tier") || localStorage.getItem("edunaija_academic_tier");
        if (savedTier) activeTier = String(savedTier).toUpperCase();
      }
      setClassTier(activeTier);
      localStorage.setItem("edunaija_class_tier", activeTier);

      const activeDev = localStorage.getItem("edunaija_dev_mode") === "true";
      setIsDevMode(activeDev);

      const handleUserUpdated = (e: any) => {
        if (e.detail) {
          setUser(e.detail);
          const raw = e.detail.class_tier || e.detail.grade_level;
          if (raw) {
            const norm = String(raw).toUpperCase();
            setClassTier(norm);
            localStorage.setItem("edunaija_class_tier", norm);
          }
        }
      };
      const handleDevModeUpdated = (e: any) => {
        if (e.detail?.isDevMode !== undefined) setIsDevMode(e.detail.isDevMode);
      };

      window.addEventListener("edunaija_user_updated", handleUserUpdated);
      window.addEventListener("edunaija_devmode_updated", handleDevModeUpdated);
      return () => {
        window.removeEventListener("edunaija_user_updated", handleUserUpdated);
        window.removeEventListener("edunaija_devmode_updated", handleDevModeUpdated);
      };
    }
  }, []);

  // Fetch Institutional Cut-off Radar & Prescribed Literature when track changes
  useEffect(() => {
    async function loadTrackData() {
      try {
        const [radarRes, litRes] = await Promise.all([
          fetch(`http://127.0.0.1:8000/api/tracks/institutional-radar?track=${academicTrack}&limit=6`),
          fetch(`http://127.0.0.1:8000/api/tracks/literature?track=${academicTrack}`)
        ]);
        if (radarRes.ok) {
          const rData = await radarRes.json();
          setInstitutionalRadar(rData.radar_data || []);
        }
        if (litRes.ok) {
          const lData = await litRes.json();
          setPrescribedLit(lData.literature_texts || []);
        }
      } catch (err) {
        console.warn("Track data fetch error:", err);
      }
    }
    loadTrackData();
  }, [academicTrack]);

  const handleTrackChange = async (newTrack: string) => {
    sfx.tap();
    triggerTmaHaptic("medium");
    setAcademicTrack(newTrack);
    const key = user?.registration_key || (typeof window !== "undefined" ? localStorage.getItem("edunaija_user_key") : null);
    if (key) {
      setIsChangingTrack(true);
      try {
        await fetch("http://127.0.0.1:8000/api/tracks/set-student-track", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ user_key: key, academic_track: newTrack })
        });
        // Dispatch update so widget re-calibrates
        const updatedUser = { ...user, academic_track: newTrack };
        setUser(updatedUser);
        localStorage.setItem("edunaija_user", JSON.stringify(updatedUser));
        window.dispatchEvent(new CustomEvent("edunaija_user_updated", { detail: updatedUser }));
      } catch {} finally {
        setIsChangingTrack(false);
      }
    }
  };

  // Real-Time live student metrics from SQLite pipeline
  useEffect(() => {
    async function loadLiveStats() {
      const regKey = user?.registration_key || (typeof window !== "undefined" ? localStorage.getItem("edunaija_user_key") || "REG-2025-8841" : "REG-2025-8841");
      try {
        const res = await fetch(`http://127.0.0.1:8000/quiz/live-stats/${regKey}`);
        if (res.ok) {
          const data = await res.json();
          setLiveStats(data);
        }
      } catch (err) {
        console.warn("Live stats load error:", err);
      }
    }
    loadLiveStats();
  }, [user]);

  // Fetch verified educational portal feeds
  const fetchPortalFeeds = async () => {
    try {
      const res = await fetch("http://127.0.0.1:8000/sync/feeds");
      if (res.ok) {
        const data = await res.json();
        if (data.feeds) setPortalFeeds(data.feeds.slice(0, 3));
      }
    } catch {}
  };

  const handleRefreshFeeds = async () => {
    sfx.tap();
    setIsSyncingFeeds(true);
    try {
      await fetch("http://127.0.0.1:8000/sync/refresh", { method: "POST" });
      await fetchPortalFeeds();
    } catch {}
    setIsSyncingFeeds(false);
  };

  useEffect(() => {
    fetchPortalFeeds();
  }, []);

  useEffect(() => {
    initTelegramMiniApp();

    const updateTimer = () => {
      const now = new Date();
      const nextSunday = new Date();
      const day = nextSunday.getDay();
      const daysUntilSunday = (7 - day) % 7;
      nextSunday.setDate(nextSunday.getDate() + daysUntilSunday);
      nextSunday.setHours(20, 0, 0, 0);

      const diff = Math.max(0, nextSunday.getTime() - now.getTime());
      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const s = Math.floor((diff % (1000 * 60)) / 1000);

      setShowdownCountdown({ days: d, hours: h, mins: m, secs: s });
    };

    updateTimer();
    const interval = setInterval(updateTimer, 1000);
    return () => clearInterval(interval);
  }, []);

  const playClick = () => {
    sfx.tap();
    triggerTmaHaptic("light");
  };

  const handleSubscribeParent = async (e: React.FormEvent) => {
    e.preventDefault();
    sfx.tap();
    try {
      const res = await fetch("http://127.0.0.1:8000/monetization/parent-pass", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          parent_name: parentName,
          parent_phone: parentPhone,
          student_key: user?.registration_key || "EDU-2025-DEMO",
          plan_type: parentPlan
        })
      });
      if (res.ok) {
        const data = await res.json();
        setParentSuccessMsg(`🎉 Guardian Angel Pass Activated! Sub ID: ${data.subscription_id}. Friday reports will be sent to ${parentPhone}`);
        sfx.correct();
      }
    } catch {
      sfx.wrong();
    }
  };

  const handleActivateSchool = async (e: React.FormEvent) => {
    e.preventDefault();
    sfx.tap();
    try {
      const res = await fetch("http://127.0.0.1:8000/monetization/school-license", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          school_name: schoolName,
          admin_email: schoolEmail,
          admin_phone: schoolPhone,
          state: "Lagos",
          licensed_students: schoolSeats
        })
      });
      if (res.ok) {
        const data = await res.json();
        setSchoolSuccessMsg(`🏫 School Term License Activated! Master Key: ${data.license_key}. Allocated ${data.licensed_students} offline CBT seats.`);
        sfx.correct();
      }
    } catch {
      sfx.wrong();
    }
  };

  const isPrimary = classTier === "PRIMARY";
  const isJss = classTier === "JSS";
  const isSss = classTier === "SSS";
  const isFreshman = classTier === "FRESHMAN";

  const displayName = user?.full_name || user?.fullName || (isPrimary ? "Tobi Adeleke" : "Chisom");
  const targetUniText = user?.target_uni || (isPrimary ? "King's College Lagos (Junior School)" : isJss ? "Senior Model College" : isFreshman ? "Faculty of Science" : "UNILAG");
  const targetCourseText = user?.target_course || (isPrimary ? "Common Entrance Distinction" : isJss ? "Junior Science Stream" : isFreshman ? "Computer Science" : "Medicine & Surgery");
  const targetScoreValue = user?.target_score || (isPrimary ? 95 : isJss ? 88 : isFreshman ? 4.85 : 290);
  const examTypeText = user?.exam_type || (isPrimary ? "National Common Entrance Examination (NCEE)" : isJss ? "BECE 2026" : isSss ? "WAEC SSCE" : isFreshman ? "100L Semester 1" : "JAMB UTME 2026");

  return (
    <main className="p-4 sm:p-6 lg:p-8 max-w-7xl mx-auto min-h-screen text-white font-sans space-y-6">
      
      {/* 1. Individualized Road to Grade A Cognitive Trajectory Widget (Strictly Auth Pipelined) */}
      {user ? (
        <RoadToGradeAWidget userKey={user.registration_key} />
      ) : (
        <div className="w-full rounded-3xl bg-gradient-to-br from-emerald-950/40 via-black/80 to-zinc-950 border border-emerald-500/30 p-6 sm:p-8 backdrop-blur-2xl shadow-[0_20px_50px_rgba(0,0,0,0.8)] relative overflow-hidden">
          {/* Background Specular Mesh */}
          <div className="absolute top-0 right-0 w-96 h-96 bg-[#00E676]/10 rounded-full blur-3xl pointer-events-none" />
          <div className="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div className="space-y-3 max-w-2xl">
              <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/25 text-[#00E676] text-xs font-mono font-bold">
                <Brain className="w-3.5 h-3.5 text-emerald-400" />
                <span>Bloom 2-Sigma Mastery Engine &bull; Individualized Database Pipeline</span>
              </div>
              <h2 className="text-2xl sm:text-3xl font-display font-black text-white tracking-tight">
                Your Individualized Road to Grade A
              </h2>
              <p className="text-zinc-300 text-sm leading-relaxed">
                You are not taught like every other student. This system diagnoses your exact prerequisite knowledge gaps and delivers pedagogical interventions tuned to your cognitive style.
                <strong className="text-white block mt-1">Sign in or register your student account to activate your personal baseline, unlock Socratic gap repair, and persist all milestones in the national database.</strong>
              </p>
            </div>

            <div className="flex flex-col sm:flex-row md:flex-col gap-3 shrink-0 w-full sm:w-auto">
              <button
                onClick={() => {
                  sfx.tap();
                  window.dispatchEvent(new CustomEvent("open_auth_modal"));
                }}
                className="px-6 py-3 rounded-2xl bg-gradient-to-r from-emerald-500 via-[#00E676] to-teal-400 text-black font-display font-black text-sm hover:brightness-110 active:scale-95 transition-all shadow-[0_0_25px_rgba(0,230,118,0.4)] flex items-center justify-center gap-2 cursor-pointer"
              >
                <KeyRound className="w-4 h-4 stroke-[2.5]" />
                <span>Sign In / Register Student Profile</span>
              </button>
              <button
                onClick={() => {
                  sfx.tap();
                  setIsGuestPreview(!isGuestPreview);
                }}
                className="px-5 py-2.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-bold text-zinc-300 hover:text-white transition-all flex items-center justify-center gap-2 cursor-pointer"
              >
                <Eye className="w-3.5 h-3.5 text-emerald-400" />
                <span>{isGuestPreview ? "Hide Sample Trajectory" : "Preview Sample Grade A Trajectory"}</span>
              </button>
            </div>
          </div>

          {/* Optional Guest Preview with clear watermark banner */}
          {isGuestPreview && (
            <div className="mt-6 pt-6 border-t border-white/10 relative">
              <div className="mb-3 px-3.5 py-2 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs font-mono flex items-center justify-between">
                <span className="flex items-center gap-2">
                  <AlertTriangle className="w-4 h-4 text-amber-400 shrink-0" />
                  <span>Guest Preview Mode &bull; Changes are not persisted to database. Register or sign in to save your personal Grade A roadmap.</span>
                </span>
                <button
                  onClick={() => window.dispatchEvent(new CustomEvent("open_auth_modal"))}
                  className="text-xs underline font-bold hover:text-white shrink-0 ml-3"
                >
                  Create Permanent Account &rarr;
                </button>
              </div>
              <RoadToGradeAWidget userKey="DEMO-UTME-2025" isGuestPreview={true} />
            </div>
          )}
        </div>
      )}
      
      {/* Academic Track Discipline Hub & Verified Institutional Clearinghouse */}
      <div className="w-full rounded-3xl bg-white/[0.03] border border-white/10 p-5 sm:p-6 backdrop-blur-xl shadow-xl space-y-4">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/10 pb-3">
          <div>
            <span className="text-[10px] font-mono font-bold text-emerald-400 uppercase tracking-widest flex items-center gap-1.5">
              <Sparkles className="w-3 h-3 text-[#00E676]" />
              Academic Discipline Track &amp; Clearinghouse Radar
            </span>
            <h3 className="text-lg font-display font-black text-white">
              Tailored Educational Resources &amp; Institutional Cut-Offs
            </h3>
          </div>
          
          {/* 4-Track Switcher */}
          <div className="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none">
            {[
              { id: "SCIENCE", label: "Science & STEM", icon: "🔬" },
              { id: "ARTS", label: "Arts & Law", icon: "⚖️" },
              { id: "COMMERCIAL", label: "Commercial & Business", icon: "💼" },
              { id: "TERTIARY_CCMAS", label: "100L CCMAS", icon: "🎓" }
            ].map((tr) => (
              <button
                key={tr.id}
                onClick={() => handleTrackChange(tr.id)}
                disabled={isChangingTrack}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold font-mono transition-all shrink-0 cursor-pointer flex items-center gap-1.5 ${
                  academicTrack === tr.id
                    ? "bg-gradient-to-r from-emerald-500 to-[#00E676] text-black font-black shadow-[0_0_15px_rgba(0,230,118,0.3)]"
                    : "bg-white/5 hover:bg-white/10 text-zinc-300 hover:text-white border border-white/5"
                }`}
              >
                <span>{tr.icon}</span>
                <span>{tr.label}</span>
              </button>
            ))}
          </div>
        </div>

        {/* 2-Column Split: Verified Institutional Cut-Off Radar (Left) & Prescribed Literature/Syllabus (Right) */}
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
          
          {/* Left: Verified Institutional Radar (7 cols) */}
          <div className="lg:col-span-7 space-y-3">
            <div className="flex items-center justify-between">
              <span className="text-xs font-mono font-bold text-zinc-300 flex items-center gap-1.5">
                <School className="w-3.5 h-3.5 text-emerald-400" />
                Accredited Institutional Cut-Off Radar ({academicTrack})
              </span>
              <span className="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
                2026 Admissions
              </span>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              {institutionalRadar.map((inst, idx) => (
                <div
                  key={idx}
                  className="p-3 rounded-2xl bg-black/40 border border-white/10 hover:border-emerald-500/30 transition-all space-y-1.5"
                >
                  <div className="flex items-center justify-between">
                    <span className="text-[10px] font-mono font-bold text-emerald-400 bg-emerald-500/15 px-2 py-0.5 rounded">
                      {inst.short_name} &bull; {inst.state}
                    </span>
                    <span className="text-xs font-black text-[#00E676] font-mono">
                      {inst.post_utme_aggregate} Agg
                    </span>
                  </div>
                  <div className="text-xs font-bold text-white line-clamp-1">
                    {inst.department}
                  </div>
                  <div className="text-[10px] text-zinc-400 font-mono flex items-center justify-between border-t border-white/5 pt-1">
                    <span>{inst.screening_format.split('+')[0].trim()}</span>
                    <strong className="text-amber-300">₦{inst.tuition_estimate_ngn.toLocaleString()}</strong>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Right: Prescribed Literature & Critical Study Hub (5 cols) */}
          <div className="lg:col-span-5 space-y-3">
            <div className="flex items-center justify-between">
              <span className="text-xs font-mono font-bold text-zinc-300 flex items-center gap-1.5">
                <BookOpen className="w-3.5 h-3.5 text-amber-400" />
                Prescribed Texts &amp; Saccadic Reading
              </span>
              <Link
                href="/reader"
                className="text-[10px] font-mono text-emerald-400 hover:underline flex items-center gap-1"
              >
                <span>Full Library</span>
                <ChevronRight className="w-3 h-3" />
              </Link>
            </div>

            <div className="space-y-2">
              {prescribedLit.slice(0, 3).map((book, idx) => (
                <div
                  key={idx}
                  className="p-3 rounded-2xl bg-black/40 border border-white/10 flex items-center justify-between gap-3 hover:border-amber-400/30 transition-all"
                >
                  <div className="space-y-0.5">
                    <span className="text-[9px] font-mono text-amber-300 bg-amber-500/10 px-1.5 py-0.2 rounded font-bold">
                      {book.genre}
                    </span>
                    <div className="text-xs font-bold text-white line-clamp-1">
                      {book.title}
                    </div>
                    <div className="text-[10px] text-zinc-400">
                      by {book.author}
                    </div>
                  </div>
                  <Link
                    href={`/reader`}
                    className="shrink-0 px-2.5 py-1.5 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/30 text-amber-300 text-xs font-bold font-mono transition-all flex items-center gap-1"
                  >
                    <span>Read</span>
                    <ArrowRight className="w-3 h-3" />
                  </Link>
                </div>
              ))}
              {prescribedLit.length === 0 && (
                <div className="p-4 rounded-2xl bg-black/30 border border-white/5 text-center text-xs text-zinc-500 font-mono">
                  Loading track curriculum resources...
                </div>
              )}
            </div>
          </div>

        </div>
      </div>

      {/* Laptop & Desktop 2-Column Bento Grid */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        {/* ================= LEFT MAIN WORKSPACE (lg:col-span-8) ================= */}
        <div className="lg:col-span-8 space-y-6">
          
          {/* 5-TIER DYNAMIC CLASS PROGRESSION SWITCHER */}
          <div className="glass-card p-4 rounded-3xl border border-white/10 bg-black/40">
            <div className="flex items-center justify-between mb-3 px-1">
              <span className="text-xs font-mono text-zinc-400 uppercase tracking-widest flex items-center gap-1.5 font-bold">
                <Sparkles className="w-3.5 h-3.5 text-[#00E676]" /> Active Academic Tier:
                <span className="text-[#00E676] font-black">{classTier}</span>
              </span>
              <div className="flex items-center gap-2">
                <Link href="/curriculum" className="text-xs text-blue-400 hover:text-blue-300 font-mono flex items-center gap-1 transition-colors">
                  Curriculum →
                </Link>
              </div>
            </div>
            <div className="grid grid-cols-5 gap-2 bg-black/60 p-1.5 rounded-2xl border border-white/10 text-center">
              {[
                { id: "PRIMARY", label: "Primary", icon: "🎒", sub: "Basic 1-6" },
                { id: "JSS", label: "JSS 1-3", icon: "📘", sub: "Basic 7-9" },
                { id: "SSS", label: "SSS 1-2", icon: "🔬", sub: "Senior" },
                { id: "UTME", label: "JAMB/WAEC", icon: "⚡", sub: "Candidate" },
                { id: "FRESHMAN", label: "100L", icon: "🎓", sub: "University" },
              ].map(tier => (
                <button
                  key={tier.id}
                  onClick={() => {
                    sfx.tap();
                    triggerTmaHaptic("light");
                    if (isDevMode) {
                      // Dev Mode instantaneous switch without exam barrier
                      setClassTier(tier.id);
                      if (typeof window !== "undefined") {
                        localStorage.setItem("edunaija_class_tier", tier.id);
                        localStorage.setItem("edunaija_academic_tier", tier.id);
                        window.dispatchEvent(new CustomEvent("edunaija_user_updated", {
                          detail: { ...(user || {}), class_tier: tier.id, grade_level: tier.id }
                        }));
                      }
                    } else if (classTier !== tier.id) {
                      setTargetPromotionTier(tier.id);
                      setIsPromotionModalOpen(true);
                    }
                  }}
                  className={`py-2.5 px-1.5 rounded-xl transition-all flex flex-col items-center justify-center cursor-pointer ${
                    classTier === tier.id
                      ? "bg-[#00E676] text-black font-black shadow-[0_0_15px_rgba(0,230,118,0.4)] scale-105"
                      : "text-zinc-400 hover:text-white hover:bg-white/5"
                  }`}
                >
