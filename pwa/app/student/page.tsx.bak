            <div className="p-4 rounded-3xl bg-gradient-to-br from-blue-950/50 via-zinc-900 to-black border border-blue-500/30 space-y-2.5 shadow-xl">
              <div className="flex items-start justify-between">
                <div>
                  <span className="text-[10px] font-mono font-bold text-blue-400 uppercase">🏫 For Schools</span>
                  <h3 className="font-bold text-xs text-white">School CBT Lab Termly License</h3>
                </div>
                <span className="font-mono text-[11px] font-black text-blue-300 bg-blue-500/10 px-2 py-0.5 rounded-xl border border-blue-500/30">
                  ₦1,500/seat
                </span>
