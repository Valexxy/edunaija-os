      {/* PARENT GUARDIAN ANGEL PASS MODAL */}
      {isParentModalOpen && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
          <div className="bg-[#0c0d14] border border-emerald-500/40 rounded-3xl p-6 max-w-md w-full shadow-2xl space-y-4">
            <div className="flex justify-between items-center border-b border-white/10 pb-3">
              <div>
                <span className="text-[10px] font-mono font-bold text-[#00E676] uppercase">Parent Peace of Mind</span>
                <h3 className="font-bold text-base text-white">Guardian Angel Weekly Report Pass</h3>
              </div>
              <button
                onClick={() => { setIsParentModalOpen(false); setParentSuccessMsg(null); }}
                className="text-zinc-400 hover:text-white text-xs font-mono cursor-pointer"
              >
                ✕ Close
              </button>
            </div>

            {parentSuccessMsg ? (
              <div className="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-200 text-xs space-y-2">
                <div className="font-bold text-sm text-[#00E676]">{parentSuccessMsg}</div>
                <p>Every Friday at 5:00 PM, you will receive an automatic WhatsApp &amp; SMS breakdown of your child's syllabus progress and cut-off predictions.</p>
              </div>
            ) : (
              <form onSubmit={handleSubscribeParent} className="space-y-3">
                <div>
                  <label className="text-xs text-zinc-300 font-semibold block mb-1">Parent's Full Name:</label>
                  <input
                    type="text"
                    required
                    placeholder="e.g. Chief & Mrs. Adeleke"
                    value={parentName}
                    onChange={(e) => setParentName(e.target.value)}
                    className="w-full bg-black/50 border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-emerald-500"
                  />
                </div>

                <div>
                  <label className="text-xs text-zinc-300 font-semibold block mb-1">Parent's WhatsApp / SMS Phone:</label>
                  <input
                    type="tel"
                    required
                    placeholder="e.g. 08031234567"
                    value={parentPhone}
                    onChange={(e) => setParentPhone(e.target.value)}
                    className="w-full bg-black/50 border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-emerald-500"
                  />
                </div>

                <div>
                  <label className="text-xs text-zinc-300 font-semibold block mb-1">Subscription Plan:</label>
                  <div className="grid grid-cols-2 gap-2">
                    <button
                      type="button"
                      onClick={() => setParentPlan("guardian_monthly")}
                      className={`p-2.5 rounded-xl border text-xs font-bold text-center cursor-pointer ${parentPlan === "guardian_monthly" ? "bg-[#00E676] text-black border-[#00E676]" : "bg-white/5 border-white/10 text-zinc-300"}`}
                    >
                      <div>Monthly Pass</div>
                      <div className="text-[10px] font-mono">₦3,500 / mo</div>
                    </button>
                    <button
                      type="button"
                      onClick={() => setParentPlan("guardian_annual")}
                      className={`p-2.5 rounded-xl border text-xs font-bold text-center cursor-pointer ${parentPlan === "guardian_annual" ? "bg-[#00E676] text-black border-[#00E676]" : "bg-white/5 border-white/10 text-zinc-300"}`}
                    >
                      <div>Annual Pass (Best)</div>
                      <div className="text-[10px] font-mono">₦25,000 / yr</div>
                    </button>
                  </div>
                </div>

                <div className="p-2.5 rounded-xl bg-white/5 text-[11px] text-zinc-400">
                  🛡️ <strong>Statutory Guarantee:</strong> 0% VAT applies under First Schedule of Nigerian VAT Act. Direct Moniepoint/Providus virtual account transfer with ₦0 EMTL fees.
                </div>

                <button
                  type="submit"
                  className="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-[#00E676] text-black font-black text-xs hover:brightness-110 active:scale-95 transition-all cursor-pointer"
                >
                  Confirm &amp; Activate Guardian Pass →
                </button>
              </form>
            )}
          </div>
        </div>
      )}

      {/* PRIVATE SCHOOL B2B TERM LICENSE MODAL */}
      {isSchoolModalOpen && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
          <div className="bg-[#0c0d14] border border-blue-500/40 rounded-3xl p-6 max-w-md w-full shadow-2xl space-y-4">
            <div className="flex justify-between items-center border-b border-white/10 pb-3">
              <div>
                <span className="text-[10px] font-mono font-bold text-blue-400 uppercase">School CBT Lab License</span>
                <h3 className="font-bold text-base text-white">B2B School Term Activation</h3>
              </div>
              <button
                onClick={() => { setIsSchoolModalOpen(false); setSchoolSuccessMsg(null); }}
                className="text-zinc-400 hover:text-white text-xs font-mono cursor-pointer"
              >
                ✕ Close
              </button>
            </div>

            {schoolSuccessMsg ? (
              <div className="p-4 rounded-2xl bg-blue-500/10 border border-blue-500/30 text-blue-200 text-xs space-y-2">
                <div className="font-bold text-sm text-blue-300">{schoolSuccessMsg}</div>
                <p>Your school computer lab can now run CBT exams 100% offline with zero internet data required!</p>
              </div>
            ) : (
              <form onSubmit={handleActivateSchool} className="space-y-3">
                <div>
                  <label className="text-xs text-zinc-300 font-semibold block mb-1">School Name:</label>
                  <input
                    type="text"
                    required
                    placeholder="e.g. Corona Secondary School, Agbara"
                    value={schoolName}
                    onChange={(e) => setSchoolName(e.target.value)}
                    className="w-full bg-black/50 border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500"
                  />
                </div>

                <div className="grid grid-cols-2 gap-2">
                  <div>
                    <label className="text-xs text-zinc-300 font-semibold block mb-1">Admin Email:</label>
                    <input
                      type="email"
                      required
                      placeholder="admin@school.edu.ng"
                      value={schoolEmail}
                      onChange={(e) => setSchoolEmail(e.target.value)}
                      className="w-full bg-black/50 border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500"
                    />
                  </div>
                  <div>
                    <label className="text-xs text-zinc-300 font-semibold block mb-1">Admin Phone:</label>
                    <input
                      type="tel"
                      required
                      placeholder="08031112233"
                      value={schoolPhone}
                      onChange={(e) => setSchoolPhone(e.target.value)}
                      className="w-full bg-black/50 border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500"
                    />
                  </div>
                </div>

                <div>
                  <label className="text-xs text-zinc-300 font-semibold block mb-1">Licensed Student Seats:</label>
                  <div className="flex items-center gap-3">
                    <input
                      type="range"
                      min="50"
                      max="1000"
                      step="50"
                      value={schoolSeats}
                      onChange={(e) => setSchoolSeats(Number(e.target.value))}
                      className="flex-1 accent-blue-500 h-2 bg-zinc-800 rounded-lg cursor-pointer"
                    />
                    <span className="font-mono text-xs font-bold text-blue-400 w-20 text-right">{schoolSeats} seats</span>
                  </div>
                  <div className="text-[11px] text-zinc-400 font-mono mt-1">
                    Term Fee: <strong className="text-white">₦{(schoolSeats * 1500).toLocaleString()}</strong> (₦1,500/student)
                  </div>
                </div>

                <button
                  type="submit"
                  className="w-full py-3 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-black text-xs hover:brightness-110 active:scale-95 transition-all shadow-[0_0_15px_rgba(37,99,235,0.3)] cursor-pointer"
                >
                  Generate School Master License Key →
                </button>
              </form>
            )}
          </div>
        </div>
      )}

      {/* Anti-Cheat Class Promotion Modal */}
      <ClassPromotionModal
        isOpen={isPromotionModalOpen}
        onClose={() => setIsPromotionModalOpen(false)}
        studentKey={user?.registration_key || "EDU-2025-LAG-1001"}
        currentTier={classTier}
        targetTier={targetPromotionTier}
        onPromotionSuccess={(newTier) => {
          setClassTier(newTier);
          setIsPromotionModalOpen(false);
        }}
      />
          {/* 100% Verifiable Learning Audit History & 30-Day Heatmap Modal */}
      <VerifiableLearningHistoryModal
        isOpen={isHistoryModalOpen}
        onClose={() => setIsHistoryModalOpen(false)}
        user={user}
      />
          {/* External Services Modals */}
      <AddToCalendarModal
        isOpen={isCalendarModalOpen}
        onClose={() => setIsCalendarModalOpen(false)}
      />
      <InteractiveCampusMap
        isOpen={isMapModalOpen}
        onClose={() => setIsMapModalOpen(false)}
      />
    </main>
  );
}